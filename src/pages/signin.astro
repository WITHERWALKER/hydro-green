---
import GoogleColor from "@/components/Icons/GoogleColor.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="Container">
    <div class="Form">
      <div class="Description">
        <h1>Inicia sesión, <span>bienvenido!</span></h1>
        <p>Choose one of the options to go.</p>
      </div>
      <form action="">
        <input
          required=""
          type="email"
          autocomplete="off"
          class="input"
          placeholder="Email"
        />

        <input
          required=""
          type="password"
          autocomplete="off"
          class="input"
          placeholder="Password"
        />
      </form>
      <div class="Divisor">
        <p>Or continue with</p>
        <span></span>
      </div>
      <a href="#"><GoogleColor /></a>
      <button>Sign In</button>
    </div>
    <img src="/img/HuertoFresas.webp" alt="" />
  </div>
</Layout>

<style lang="scss">
  body {
    background-color: var(--Bg-Color);
  }

  .Container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: 1fr;
    grid-template-areas: "Form Img";
    width: 56.25rem;

    .Form {
      grid-area: Form;
      display: flex;
      justify-content: center;
      flex-direction: column;
      padding: 3rem;
      height: 37.5rem;
      width: 28.125rem;
      background-color: #ffffff;
      border-top-left-radius: var(--Border);
      border-bottom-left-radius: var(--Border);

      .Description {
        margin-bottom: 1.75rem;

        h1 {
          font-size: 2em;
          margin-bottom: 0.5rem;
          color: var(--Black-Color);

          span {
            font-weight: 600;
            color: var(--Secondary-Color);
          }
        }

        p {
          color: var(--Grey-Color);
        }
      }

      .Divisor {
        margin: 1.125rem 0;
        display: flex;
        align-items: center;

        p {
          font-size: 1em;
          color: var(--Grey-Color);
          margin-right: 0.75rem;
        }

        span {
          border: 1px solid var(--Grey-Color);
          opacity: 0.5;
          width: 13.75rem;
          height: 0;
        }
      }

      a {
        display: flex;
        justify-content: center;
        background-color: #e6e6e6;
        padding: 0.75rem;
        margin: 0 auto;
        width: 90%;
        border-radius: 0.5rem;
        text-align: center;

        &:hover {
          background-color: var(--Bg-Color);
          transition: 0.4s ease-out;
        }
      }

      button {
        margin: 4rem auto 0;
        display: flex;
        justify-content: center;
        padding: 0.7rem;
        width: 60%;
        background-color: var(--Primary-Color);
        color: var(--White-Color);
        border-radius: var(--Border);
        font-size: 1.1em;
        font-weight: 500;

        &:hover {
          background-color: var(--Hover-Primary-Color);
          transition: 0.3s ease;
        }
      }
    }
  }

  img {
    grid-area: Img;
    width: 28.125rem;
    height: 37.5rem;
    border-top-right-radius: var(--Border);
    border-bottom-right-radius: var(--Border);
  }

  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;

    input {
      width: 100%;
      height: 3.25rem;
      border: 1px solid #b6b6b6;
      border-radius: 0.5rem;
      padding: 0.75rem;

      &:focus {
        outline: none;
        border: 2px solid var(--Hover-Primary-Color);
      }
    }
  }
</style>

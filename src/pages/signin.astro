---
import GoogleColor from "@/components/Icons/GoogleColor.astro";
import Layout from "@/layouts/Layout.astro";
import Input from "@/components/Input.astro";
---

<Layout>
  <div class="Container">
    <div class="Form">
      <div class="Description">
        <h1>Inicia sesión, <span>bienvenido!</span></h1>
        <p>Elige una de las opciones para acceder.</p>
      </div>
      <form action="">
        <Input type="email" placeholder="Correo electronico" />
        <Input type="password" placeholder="Contraseña" />
      </form>
      <div class="Divisor">
        <p>O continua con Google</p>
        <span></span>
      </div>
      <a href="#"><GoogleColor /></a>
      <button>Sign In</button>
    </div>
    <img src="/img/HuertoFresas.webp" alt="" />
  </div>
</Layout>

<style lang="scss">
  body {
    background-color: var(--Bg-Color);
  }

  .Container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: 1fr;
    grid-template-areas: "Form Img";
    width: 56.25rem;

    .Form {
      grid-area: Form;
      display: flex;
      margin: 0 auto;
      justify-content: center;
      flex-direction: column;
      padding: 3rem;
      height: 37.5rem;
      width: 28.125rem;
      background-color: #ffffff;
      border-top-left-radius: var(--Border);
      border-bottom-left-radius: var(--Border);

      .Description {
        margin-bottom: 1.75rem;

        h1 {
          font-size: 2em;
          margin-bottom: 0.5rem;
          color: var(--Black-Color);

          span {
            font-weight: 600;
            color: var(--Green-Color-500);
          }
        }

        p {
          color: var(--Grey-Color);
        }
      }

      .Divisor {
        margin: 1.125rem 0;
        display: flex;
        align-items: center;

        p {
          font-size: 1em;
          color: var(--Grey-Color);
          margin-right: 0.75rem;
        }

        span {
          border: 1px solid var(--Grey-Color);
          opacity: 0.5;
          width: 11.25rem;
          height: 0;
        }
      }

      a {
        display: flex;
        justify-content: center;
        background-color: #e6e6e6;
        padding: 0.75rem;
        margin: 0 auto;
        width: 60%;
        border-radius: 0.5rem;
        text-align: center;

        &:hover {
          background-color: var(--Bg-Color);
          transition: 0.4s ease-out;
        }
      }

      button {
        margin: 4rem auto 0;
        display: flex;
        justify-content: center;
        padding: 0.7rem;
        width: 60%;
        background-color: var(--Green-Color-500);
        color: var(--White-Color);
        border-radius: var(--Border);
        font-size: 1.1em;
        font-weight: 500;

        &:hover {
          background-color: var(--Green-Color-400);
          transition: 0.3s ease;
        }
      }
    }
  }

  img {
    grid-area: Img;
    width: 28.125rem;
    height: 37.5rem;
    border-top-right-radius: var(--Border);
    border-bottom-right-radius: var(--Border);
  }

  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (width <= 1024px) {
    .Container {
      display: grid;
      justify-items: center;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      grid-template-areas: "Form";
      width: auto;

      .Form {
        padding: 1.5rem;
        width: 24rem;
        height: 33rem;
        border-radius: var(--Border);

        .Description {
          font-size: 0.9rem;
        }

        .Divisor {
          p {
            font-size: 0.8em;
          }
        }

        button {
          margin: 3rem auto 0;
        }
      }

      img {
        display: none;
      }
    }
  }
</style>

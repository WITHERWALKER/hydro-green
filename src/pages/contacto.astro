---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import { Mail, Phone, MapPin, Send } from "@lucide/astro";
---

<Layout
  title="Contacto"
  description="Contacta con HydroGreen. Solicita asesoría personalizada sobre sistemas hidropónicos inteligentes para cultivo de fresas."
>
  <Header />
  <main id="main-content" class="pt-20 sm:pt-24 lg:pt-28">
    <section class="py-10 sm:py-14 lg:py-16 xl:py-24 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10 sm:mb-14 lg:mb-20">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-100/80 rounded-full mb-5 sm:mb-6"
          >
            <span class="text-xs font-medium text-green-800 uppercase tracking-wider">Contacto</span
            >
          </span>
          <h1
            class="font-display text-[clamp(2rem,6vw,3.5rem)] font-bold text-ink tracking-tight leading-none"
          >
            Hablemos
          </h1>
          <p
            class="mt-3 sm:mt-4 text-ink-light max-w-xl mx-auto text-[15px] sm:text-base leading-relaxed px-2 sm:px-0"
          >
            Completa el formulario y te responderemos en menos de 24 horas.
          </p>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-5 gap-10 sm:gap-12 lg:gap-10 xl:gap-16 2xl:gap-32 items-start"
        >
          <div class="lg:col-span-3">
            <form class="flex flex-col gap-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="flex flex-col">
                  <label
                    for="name"
                    class="text-xs font-medium text-ink-muted uppercase tracking-wider mb-2"
                    >Nombre</label
                  >
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Tu nombre"
                    class="w-full h-12 px-0 bg-transparent border-b-2 border-sand text-ink text-sm outline-none transition-all duration-300 placeholder:text-ink-muted/50 focus:border-green-600"
                  />
                </div>
                <div class="flex flex-col">
                  <label
                    for="email"
                    class="text-xs font-medium text-ink-muted uppercase tracking-wider mb-2"
                    >Correo electrónico</label
                  >
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="tu@email.com"
                    class="w-full h-12 px-0 bg-transparent border-b-2 border-sand text-ink text-sm outline-none transition-all duration-300 placeholder:text-ink-muted/50 focus:border-green-600"
                  />
                </div>
              </div>

              <div class="flex flex-col">
                <label
                  for="subject"
                  class="text-xs font-medium text-ink-muted uppercase tracking-wider mb-2"
                  >Asunto</label
                >
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  placeholder="¿En qué podemos ayudarte?"
                  class="w-full h-12 px-0 bg-transparent border-b-2 border-sand text-ink text-sm outline-none transition-all duration-300 placeholder:text-ink-muted/50 focus:border-green-600"
                />
              </div>

              <div class="flex flex-col">
                <label
                  for="message"
                  class="text-xs font-medium text-ink-muted uppercase tracking-wider mb-2"
                  >Mensaje</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Cuéntanos los detalles de tu proyecto o pregunta..."
                  class="w-full px-0 py-3 bg-transparent border-b-2 border-sand text-ink text-sm outline-none transition-all duration-300 placeholder:text-ink-muted/50 focus:border-green-600 resize-none"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="group inline-flex items-center gap-2.5 px-8 py-3.5 bg-green-700 text-cream rounded-full text-sm font-semibold hover:bg-green-800 hover:shadow-green-btn hover:scale-[1.02] active:scale-[0.97] transition-all duration-300"
                >
                  Enviar mensaje
                  <Send
                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </button>
              </div>
            </form>
          </div>

          <div
            class="lg:col-span-2 flex flex-col gap-6 lg:pt-1 p-5 sm:p-6 lg:p-0 bg-white lg:bg-transparent border border-sand lg:border-0 rounded-2xl lg:rounded-none shadow-sm lg:shadow-none"
          >
            <div class="flex items-start gap-4">
              <div
                class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center shrink-0 text-green-700"
              >
                <Mail class="w-5 h-5" />
              </div>
              <div class="min-w-0">
                <h3 class="text-sm font-semibold text-ink mb-1">Correo electrónico</h3>
                <p class="text-sm text-ink-light break-all">info@hydrogreen.com</p>
                <p class="text-sm text-ink-light break-all">soporte@hydrogreen.com</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center shrink-0 text-green-700"
              >
                <Phone class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-sm font-semibold text-ink mb-1">Teléfono</h3>
                <p class="text-sm text-ink-light">+52 (55) 1234-5678</p>
                <p class="text-sm text-ink-light">Lunes a viernes, 9:00 - 18:00 hrs</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center shrink-0 text-green-700"
              >
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-sm font-semibold text-ink mb-1">Ubicación</h3>
                <p class="text-sm text-ink-light">Av. Sostenibilidad 123</p>
                <p class="text-sm text-ink-light">Ciudad de México, CP 01000</p>
              </div>
            </div>

            <div class="mt-2 p-4 sm:p-5 bg-green-50 border border-green-200 rounded-2xl">
              <p class="text-xs sm:text-sm text-ink-light leading-relaxed">
                ¿Ya eres cliente? Visita nuestro <a
                  href="#"
                  class="text-green-700 font-medium hover:underline">centro de soporte</a
                > para asistencia técnica inmediata.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

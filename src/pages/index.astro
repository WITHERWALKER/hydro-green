---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <Header />
    <Hero />
  </main>
</Layout>

<style>
  main {
    width: 90%;
    margin: 0 auto;
  }

  @media (width <= 768px) {
    main {
      width: 100%;
    }
  }
</style>

---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Card from "@/components/DashboardComponents/Card.astro";
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
const auth = getAuth(app);

/* Verificar la sesión actual */
if (!Astro.cookies.has("session")) {
  return Astro.redirect("/signin");
}
const sessionCookie = Astro.cookies.get("session").value;
const decodedCookie = await auth.verifySessionCookie(sessionCookie);
const user = await auth.getUser(decodedCookie.uid);

if (!user) {
  return Astro.redirect("/signin");
}
---

<DashboardLayout>
  <h2>Informació en tiempo real</h2>
  <section>
    <div class="G1 Grafic"></div>

    <div class="G2 Grafic"></div>

    <div class="G3 Grafic"></div>

    <div class="G4 Grafic"></div>

    <div class="I1">
      <Card title="Strawberry" subtitle="Strawberry" info="Documents: 7" />
    </div>

    <div class="I2">
      <Card title="Strawberry" subtitle="Strawberry" info="Documents: 10" />
    </div>

    <div class="I3">
      <Card title="Strawberry" subtitle="Strawberry" info="Documents: 3" />
    </div>

    <div class="I4">
      <Card title="Strawberry" subtitle="Strawberry" info="Documents: 50" />
    </div>
  </section>
</DashboardLayout>

<style lang="scss">
  h2 {
    font-size: 1.5em;
    padding: 1.5rem 18rem;
    color: var(--Black-Color);
  }

  section {
    height: calc(100vh - 12rem);
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 1rem;
    width: 70%;
    margin: 0 auto;
    grid-template-areas:
      "G1 G1 G1 G2 G2 G3 G3"
      "G1 G1 G1 G2 G2 G3 G3"
      "I1 I1 I3 I3 G4 G4 G4"
      "I2 I2 I4 I4 G4 G4 G4";

    .Grafic {
      background-color: var(--Green-Color-200);
    }

    .G1 {
      grid-area: G1;
    }

    .I1 {
      grid-area: I1;
    }

    .I2 {
      grid-area: I2;
    }

    .G2 {
      grid-area: G2;
    }

    .I3 {
      grid-area: I3;
    }

    .I4 {
      grid-area: I4;
    }

    .G3 {
      grid-area: G3;
    }

    .G4 {
      grid-area: G4;
    }

    div {
      border-radius: var(--Border);
    }
  }
</style>

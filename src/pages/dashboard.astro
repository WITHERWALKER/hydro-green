---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { Plus, Download } from "@lucide/astro";
import {
  productionYear,
  cropStages,
  todayAgenda,
  criticalLot,
  lotsInProduction,
  opsTasks,
} from "@/data/dashboard";

const now = new Date();
const weekdayRaw = new Intl.DateTimeFormat("es-MX", { weekday: "long" }).format(now);
const dayName = weekdayRaw.charAt(0).toUpperCase() + weekdayRaw.slice(1);
const shortDate = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "short" }).format(now);
const riegos = todayAgenda.filter((a) => a.title.toLowerCase().includes("riego")).length || 3;
const cosechas = cropStages.stages.find((s) => s.label === "Cosecha")?.count ?? 2;
---

<DashboardLayout>
  <div
    class="flex min-h-[calc(100vh-64px)] flex-col overflow-x-hidden px-4 py-6 sm:px-6 sm:py-7 lg:px-8 lg:py-8"
  >
    <!-- Header Title Row -->
    <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-3xl font-extrabold leading-none tracking-tight text-zinc-900 sm:text-4xl">
          {dayName}.
        </h1>
        <p
          class="mt-1 text-2xl font-semibold leading-tight tracking-tight text-zinc-500 sm:text-3xl"
        >
          {riegos}
          {riegos === 1 ? "riego programado" : "riegos programados"}, {cosechas}
          {cosechas === 1 ? "cosecha lista" : "cosechas listas"}.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2.5">
        <!-- Registrar lectura - icono con tooltip -->
        <div class="group relative">
          <a
            href="#"
            aria-label="Registrar lectura - Añadir medición de pH, EC y nutrientes"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 bg-white text-green-700 shadow-sm transition-colors duration-300 ease-out hover:border-green-700/20 hover:bg-green-50"
          >
            <Plus class="size-4.5" />
          </a>
          <div
            class="pointer-events-none absolute left-0 top-[calc(100%+10px)] z-10 whitespace-nowrap rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-medium text-white opacity-0 shadow-lg transition-opacity duration-300 ease-out group-hover:opacity-100 sm:left-1/2 sm:-translate-x-1/2"
          >
            Registrar lectura
            <span
              class="absolute -top-1 left-4 h-2 w-2 rotate-45 bg-zinc-900 sm:left-1/2 sm:-translate-x-1/2"
            ></span>
          </div>
        </div>

        <!-- Exportar reporte - icono con tooltip -->
        <div class="group relative">
          <a
            href="#"
            aria-label="Exportar reporte - Descargar CSV de producción"
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-zinc-900 text-white shadow-sm transition-colors duration-300 ease-out hover:bg-black"
          >
            <Download class="size-4.5" />
          </a>
          <div
            class="pointer-events-none absolute right-0 top-[calc(100%+10px)] z-10 whitespace-nowrap rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-medium text-white opacity-0 shadow-lg transition-opacity duration-300 ease-out group-hover:opacity-100"
          >
            Exportar reporte
            <span class="absolute -top-1 right-4 h-2 w-2 rotate-45 bg-zinc-900"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-1 flex-col justify-center gap-4">
      <!-- ROW 1: 3 cards -->
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        <!-- Producción · Año en curso (dark green) -->
        <div class="flex flex-col rounded-[20px] bg-[#0F3D2E] p-6 text-white lg:col-span-5 lg:p-7">
          <div class="flex items-start justify-between gap-4">
            <p class="text-xs font-medium uppercase tracking-widest text-white/60">
              Producción · Año en curso
            </p>
            <span
              class="shrink-0 rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-medium leading-none text-lime-200"
            >
              {productionYear.pct}% de {productionYear.goalKg.toLocaleString("es-MX")}kg meta
            </span>
          </div>

          <p
            class="mt-5 text-4xl font-extrabold leading-none tracking-tight text-white sm:text-5xl"
          >
            {productionYear.totalKg.toLocaleString("es-MX")} kg
          </p>
          <p class="mt-1.5 text-sm text-white/60">
            {productionYear.delta} · {productionYear.eta}
          </p>

          <!-- Bar chart -->
          <div class="mt-auto pt-8">
            <div class="flex h-26 items-end gap-1.5 sm:gap-2">
              {
                productionYear.months.map((m) => (
                  <div class="flex flex-1 flex-col items-center gap-2">
                    <div
                      class={`w-full rounded-md ${m.accent ? "bg-lime-200" : "bg-white/15"}`}
                      style={`height: ${m.h}px`}
                    />
                    <span
                      class={`text-xs font-medium tracking-widest ${m.accent ? "font-bold text-lime-200" : "text-white/40"}`}
                    >
                      {m.label}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Ciclo de cultivo -->
        <div class="flex flex-col rounded-[20px] bg-white p-6 shadow-sm lg:col-span-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
              Ciclo de cultivo
            </h3>
            <span class="rounded-full bg-zinc-100 px-2 py-1 text-xs font-medium text-zinc-400"
              >NFT · fresa</span
            >
          </div>

          <p class="mt-3 text-4xl font-extrabold leading-none tracking-tight text-zinc-900">
            {cropStages.total}
          </p>
          <p class="text-sm text-zinc-500">
            lotes activos · <span class="font-medium text-red-600"
              >{cropStages.critical} críticos</span
            >
          </p>

          <div class="mt-6 space-y-3.5">
            {
              cropStages.stages.map((s) => (
                <div class="flex items-center gap-3">
                  <span class="w-18 shrink-0 text-xs font-medium text-zinc-900">{s.label}</span>
                  <div class="flex-1">
                    <div class="h-1.5 overflow-hidden rounded-full bg-stone-100">
                      <div
                        class="h-full rounded-full"
                        style={`width: ${s.w}%; background: ${s.color}`}
                      />
                    </div>
                  </div>
                  <span class="w-6 text-right text-xs font-semibold text-zinc-900">{s.count}</span>
                </div>
              ))
            }
          </div>

          <a
            href="#"
            class="mt-auto block pt-6 text-center text-sm font-medium text-green-700 hover:underline"
          >
            Ver ciclo completo →
          </a>
        </div>

        <!-- Hoy agenda dinámica -->
        <div class="flex flex-col rounded-[20px] bg-white p-6 shadow-sm lg:col-span-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
              Hoy · {shortDate}
            </h3>
            <span class="h-2 w-2 rounded-full bg-green-700 animate-pulse" aria-hidden="true"></span>
          </div>

          <div class="mt-6 flex flex-1 flex-col gap-5">
            {
              todayAgenda.map((item) => (
                <div class="flex gap-3">
                  <span class="w-10 shrink-0 text-xs font-bold text-zinc-900">{item.time}</span>
                  <span
                    class="mt-1.5 h-2 w-2 shrink-0 rounded-full"
                    style={`background:${item.dot}`}
                  />
                  <div class="-mt-0.5">
                    <p class="text-sm font-semibold leading-none text-zinc-900">{item.title}</p>
                    <p class="mt-1 text-xs leading-none text-zinc-400">{item.sub}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <a
            href="#"
            class="mt-6 block text-center text-sm font-medium text-green-700 hover:underline"
          >
            Ver agenda completa →
          </a>
        </div>
      </div>

      <!-- ROW 2: 3 cards -->
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        <!-- Lote crítico -->
        <div class="flex flex-col rounded-[20px] bg-white p-6 shadow-sm lg:col-span-3">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
              Lote crítico
            </h3>
            <span
              class="shrink-0 rounded-full border border-orange-200 bg-orange-50 px-2.5 py-1 text-xs font-bold leading-none text-orange-600"
              >{criticalLot.alert}</span
            >
          </div>

          <div class="mt-5 flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-full bg-orange-50 text-orange-600"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                ><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z"></path><circle
                  cx="12"
                  cy="9"
                  r="2.5"></circle></svg
              >
            </div>
            <div>
              <p class="text-sm font-bold leading-none text-zinc-900">
                {criticalLot.variety} · {criticalLot.lot}
              </p>
              <p class="mt-1 text-xs leading-none text-zinc-400">{criticalLot.detail}</p>
              <p class="mt-1 text-xs font-medium leading-none text-orange-600">
                {criticalLot.ec} · {criticalLot.ph}
              </p>
            </div>
          </div>

          <div class="mt-4 rounded-xl bg-stone-50 p-3.5">
            <p class="text-sm leading-relaxed text-zinc-600">
              {criticalLot.desc}
            </p>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <a
              href="#"
              class="flex items-center gap-1.5 rounded-full bg-zinc-900 px-3.5 py-2 text-xs font-medium text-white hover:bg-black"
            >
              Ver detalle
            </a>
            <a
              href="#"
              class="flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3.5 py-2 text-xs font-medium text-zinc-900 hover:bg-zinc-50"
            >
              Ajustar riego
            </a>
            <a
              href="#"
              class="flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3.5 py-2 text-xs font-medium text-zinc-900 hover:bg-zinc-50"
            >
              Silenciar
            </a>
          </div>
        </div>

        <!-- Lotes en producción -->
        <div class="flex flex-col rounded-[20px] bg-white p-6 shadow-sm lg:col-span-5">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
              Lotes en producción · 6.1T
            </h3>
            <a href="#" class="text-xs font-medium text-green-700 hover:underline"
              >Todos los lotes →</a
            >
          </div>

          <div class="mt-6 space-y-5">
            {
              lotsInProduction.map((row) => (
                <div>
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="text-sm font-bold leading-none text-zinc-900">{row.kg}</p>
                      <p class="mt-1 text-xs leading-none text-zinc-400">{row.lot}</p>
                    </div>
                    <div class="hidden flex-1 items-center gap-1.5 px-6 sm:flex">
                      {Array.from({ length: 5 }).map((_, i) => {
                        const filled = i < row.prog;
                        const bg = filled
                          ? row.tone === "red"
                            ? "bg-red-600"
                            : "bg-green-700"
                          : "bg-stone-100";
                        return <div class={`h-1.5 flex-1 rounded-full ${bg}`} />;
                      })}
                    </div>
                    <span
                      class={`shrink-0 text-xs font-medium ${row.tone === "red" ? "text-red-600" : row.tone === "green" ? "text-green-700" : "text-zinc-400"}`}
                    >
                      {row.status}
                    </span>
                  </div>
                  <div class="mt-2 flex gap-1.5 sm:hidden">
                    {Array.from({ length: 5 }).map((_, i) => {
                      const filled = i < row.prog;
                      const bg = filled
                        ? row.tone === "red"
                          ? "bg-red-600"
                          : "bg-green-700"
                        : "bg-stone-100";
                      return <div class={`h-1.5 flex-1 rounded-full ${bg}`} />;
                    })}
                  </div>
                </div>
              ))
            }
          </div>

          <div
            class="mt-6 hidden grid-cols-5 gap-2 text-xs font-medium uppercase tracking-widest text-zinc-400 sm:grid"
          >
            <span class="text-center">Siembra</span>
            <span class="text-center">Germinac.</span>
            <span class="text-center">Floración</span>
            <span class="text-center">Fructific.</span>
            <span class="text-center">Cosecha</span>
          </div>
        </div>

        <!-- Tareas agronómicas (dark) -->
        <div class="flex flex-col rounded-[20px] bg-zinc-900 p-6 text-white lg:col-span-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white/50">
              Tareas agronómicas
            </h3>
            <span
              class="rounded-full bg-orange-950/60 px-2.5 py-1 text-xs font-semibold leading-none text-orange-300"
              >{opsTasks.overdue} vencidas</span
            >
          </div>

          <div class="mt-5 divide-y divide-white/10">
            {
              opsTasks.tasks.map((t) => (
                <div class="flex items-start gap-3 py-3.5 first:pt-0 last:pb-0">
                  <span class="mt-0.5 flex h-4.5 w-4.5 shrink-0 items-center justify-center rounded-[5px] border border-white/20" />
                  <div class="flex-1">
                    <p class="text-sm font-medium leading-none text-white">{t.title}</p>
                    <p class="mt-1 text-xs leading-none text-white/50">{t.sub}</p>
                  </div>
                  <span
                    class={`shrink-0 text-xs font-medium ${t.overdue ? "text-orange-300" : "text-white/60"}`}
                  >
                    {t.due}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

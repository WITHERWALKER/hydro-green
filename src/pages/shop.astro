---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
---

<Layout
  title="Tienda"
  description="Fresas frescas cultivadas con tecnología hidropónica, directamente de nuestro invernadero a tu mesa. Paquetes y suscripciones disponibles."
>
  <Header />
  <main id="main-content" class="pt-32">
    <Container class="py-12">
      <div class="mb-12">
        <Badge text="Tienda" />
        <h1
          class="font-display text-[clamp(2rem,0.5rem+4vw,3.5rem)] font-bold text-ink tracking-tight mt-4"
        >
          Nuestros productos
        </h1>
        <p class="mt-3 text-ink-light text-lg max-w-2xl">
          Fresas frescas cultivadas con tecnología hidropónica, directamente de nuestro invernadero
          a tu mesa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <article
          class="group bg-surface border border-sand rounded-3xl overflow-hidden transition-all duration-500 hover:border-green-300 hover:shadow-[var(--shadow-green-lg)] hover:-translate-y-1"
        >
          <div class="relative overflow-hidden aspect-[4/3]">
            <img
              src="/img/Fresa8.webp"
              alt="Paquete de Fresas"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-green-900/20 to-transparent"></div>
            <span
              class="absolute top-4 left-4 px-3 py-1 bg-green-700 text-cream text-xs font-semibold rounded-full"
              >Popular</span
            >
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-semibold text-ink mb-2">Paquete de Fresas</h3>
            <p class="text-sm text-ink-light mb-4">
              Fresas frescas de cultivo hidropónico, sabor y calidad premium.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-display font-bold text-green-700">$80.00</span>
              <Button href="/contacto" variant="primary" size="sm">Comprar</Button>
            </div>
          </div>
        </article>

        <article
          class="group bg-surface border border-sand rounded-3xl overflow-hidden transition-all duration-500 hover:border-green-300 hover:shadow-[var(--shadow-green-lg)] hover:-translate-y-1"
        >
          <div class="relative overflow-hidden aspect-[4/3]">
            <img
              src="/img/Fresa5.webp"
              alt="Caja Premium"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-green-900/20 to-transparent"></div>
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-semibold text-ink mb-2">Caja Premium</h3>
            <p class="text-sm text-ink-light mb-4">
              Selección de las mejores fresas, empaque ecológico.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-display font-bold text-green-700">$150.00</span>
              <Button href="/contacto" variant="primary" size="sm">Comprar</Button>
            </div>
          </div>
        </article>

        <article
          class="group bg-surface border border-sand rounded-3xl overflow-hidden transition-all duration-500 hover:border-green-300 hover:shadow-[var(--shadow-green-lg)] hover:-translate-y-1"
        >
          <div class="relative overflow-hidden aspect-[4/3]">
            <img
              src="/img/Fresa7.webp"
              alt="Suscripción Mensual"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-green-900/20 to-transparent"></div>
            <span
              class="absolute top-4 left-4 px-3 py-1 bg-accent text-ink text-xs font-semibold rounded-full"
              >Ahorra 20%</span
            >
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-semibold text-ink mb-2">Suscripción Mensual</h3>
            <p class="text-sm text-ink-light mb-4">
              Recibe fresas frescas cada semana en tu puerta.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-display font-bold text-green-700"
                >$299.00<span class="text-sm font-normal text-ink-light">/mes</span></span
              >
              <Button href="/contacto" variant="primary" size="sm">Suscribir</Button>
            </div>
          </div>
        </article>
      </div>
    </Container>
  </main>
  <Footer />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";

import strawberryImage from "@/assets/strawberry-about.webp";
---

<Layout
  title="Tienda"
  description="Fresas frescas cultivadas con tecnología hidropónica, directamente de nuestro invernadero a tu mesa. Paquetes y suscripciones disponibles."
>
  <Header />
  <main id="main-content" class="pt-20 sm:pt-24 lg:pt-28">
    <Container class="py-8 sm:py-10 lg:py-12">
      <div class="mb-8 sm:mb-10 lg:mb-12">
        <Badge text="Tienda" />
        <h1
          class="font-display text-[clamp(1.85rem,6vw,3.5rem)] font-bold text-ink tracking-tight mt-3 sm:mt-4 leading-none"
        >
          Nuestros productos
        </h1>
        <p class="mt-3 sm:mt-3 text-ink-light text-base sm:text-lg max-w-2xl leading-relaxed">
          Fresas frescas cultivadas con tecnología hidropónica, directamente de nuestro invernadero
          a tu mesa.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 lg:gap-8">
        <article
          class="group bg-surface border border-sand rounded-3xl overflow-hidden transition-all duration-500 hover:border-green-300 hover:shadow-(--shadow-green-lg) hover:-translate-y-1"
        >
          <div class="relative overflow-hidden aspect-4/3">
            <img
              src={strawberryImage.src}
              alt="Paquete de Fresas"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-linear-to-t from-green-900/20 to-transparent"></div>
            <span
              class="absolute top-4 left-4 px-3 py-1 bg-green-700 text-cream text-xs font-semibold rounded-full"
              >Popular</span
            >
          </div>
          <div class="p-5 sm:p-6">
            <h3 class="font-display text-lg sm:text-xl font-semibold text-ink mb-1.5 sm:mb-2">
              Paquete de Fresas
            </h3>
            <p class="text-sm text-ink-light mb-4 leading-relaxed">
              Fresas frescas de cultivo hidropónico, sabor y calidad premium.
            </p>
            <div class="flex items-center justify-between gap-3">
              <span class="text-xl sm:text-2xl font-display font-bold text-green-700">$80.00</span>
              <Button href="/contacto" variant="primary" size="sm">Comprar</Button>
            </div>
          </div>
        </article>

        <article
          class="group bg-surface border border-sand rounded-3xl overflow-hidden transition-all duration-500 hover:border-green-300 hover:shadow-(--shadow-green-lg) hover:-translate-y-1"
        >
          <div class="relative overflow-hidden aspect-4/3">
            <img
              src={strawberryImage.src}
              alt="Caja Premium"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-linear-to-t from-green-900/20 to-transparent"></div>
          </div>
          <div class="p-5 sm:p-6">
            <h3 class="font-display text-lg sm:text-xl font-semibold text-ink mb-1.5 sm:mb-2">
              Caja Premium
            </h3>
            <p class="text-sm text-ink-light mb-4 leading-relaxed">
              Selección de las mejores fresas, empaque ecológico.
            </p>
            <div class="flex items-center justify-between gap-3">
              <span class="text-xl sm:text-2xl font-display font-bold text-green-700">$150.00</span>
              <Button href="/contacto" variant="primary" size="sm">Comprar</Button>
            </div>
          </div>
        </article>

        <article
          class="group bg-surface border border-sand rounded-3xl overflow-hidden transition-all duration-500 hover:border-green-300 hover:shadow-(--shadow-green-lg) hover:-translate-y-1 sm:col-span-2 lg:col-span-1"
        >
          <div class="relative overflow-hidden aspect-4/3">
            <img
              src={strawberryImage.src}
              alt="Suscripción Mensual"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
            <div class="absolute inset-0 bg-linear-to-t from-green-900/20 to-transparent"></div>
            <span
              class="absolute top-3 sm:top-4 left-3 sm:left-4 px-3 py-1 bg-accent text-ink text-xs font-semibold rounded-full"
              >Ahorra 20%</span
            >
          </div>
          <div class="p-5 sm:p-6">
            <h3 class="font-display text-lg sm:text-xl font-semibold text-ink mb-1.5 sm:mb-2">
              Suscripción Mensual
            </h3>
            <p class="text-sm text-ink-light mb-4 leading-relaxed">
              Recibe fresas frescas cada semana en tu puerta.
            </p>
            <div class="flex items-center justify-between gap-3">
              <span class="text-xl sm:text-2xl font-display font-bold text-green-700"
                >$299.00<span class="text-sm font-normal text-ink-light">/mes</span></span
              >
              <Button href="/contacto" variant="primary" size="sm">Suscribir</Button>
            </div>
          </div>
        </article>
      </div>
    </Container>
  </main>
  <Footer />
</Layout>

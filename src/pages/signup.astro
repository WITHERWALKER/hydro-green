---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="Container">
    <div class="Form">
      <div class="Description">
        <h1>Comienza tu <span>viaje aqui!</span></h1>
        <p>Choose one of the options to go.</p>
      </div>
      <form action="">
        <input
          required=""
          type="text"
          autocomplete="off"
          class="input"
          placeholder="Name"
        />

        <input
          required=""
          type="email"
          autocomplete="off"
          class="input"
          placeholder="Email"
        />

        <input
          required=""
          type="password"
          autocomplete="off"
          class="input"
          placeholder="Password"
        />
      </form>

      <button>Sign Up</button>
    </div>
    <img src="/img/FresasFrescas.webp" alt="" />
  </div>
</Layout>

<style lang="scss">
  body {
    background-color: var(--Bg-Color);
  }

  .Container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: 1fr;
    grid-template-areas: "Img Form";
    width: 56.25rem;

    .Form {
      grid-area: Form;
      display: flex;
      justify-content: center;
      flex-direction: column;
      padding: 3rem;
      height: 37.5rem;
      width: 28.125rem;
      background-color: #ffffff;
      border-top-right-radius: var(--Border);
      border-bottom-right-radius: var(--Border);

      .Description {
        margin-bottom: 1.75rem;
        width: 100%;

        h1 {
          font-size: 2em;
          margin-bottom: 0.5rem;

          span {
            font-weight: 600;
            color: var(--Secondary-Color);
          }
        }

        p {
          color: var(--Grey-Color);
        }
      }

      button {
        margin: 4rem auto 0;
        display: flex;
        justify-content: center;
        padding: 0.7rem;
        width: 60%;
        background-color: var(--Primary-Color);
        color: var(--White-Color);
        border-radius: var(--Border);
        font-size: 1.1em;
        font-weight: 500;

        &:hover {
          background-color: var(--Hover-Primary-Color);
          transition: 0.3s ease;
        }
      }
    }
  }

  img {
    grid-area: Img;
    width: 28.125rem;
    height: 37.5rem;
    object-fit: cover;
    border-top-left-radius: var(--Border);
    border-bottom-left-radius: var(--Border);
  }

  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;

    input {
      width: 100%;
      height: 3.25rem;
      border: 1px solid #b6b6b6;
      border-radius: 0.5rem;
      padding: 0.75rem;

      &:focus {
        outline: none;
        border: 2px solid var(--Hover-Primary-Color);
      }
    }
  }
</style>

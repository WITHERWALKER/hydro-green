---
import Layout from "@/layouts/Layout.astro";
import Input from "@/components/Input.astro";
---

<Layout
  title="Crear cuenta"
  description="Crea tu cuenta HydroGreen y comienza a cultivar fresas con tecnología hidropónica inteligente."
>
  <div class="flex min-h-screen">
    <div class="hidden lg:block lg:w-1/2 relative">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent to-cream/20 z-10"></div>
      <img
        src="/img/Fresa1.webp"
        alt="Fresas frescas de cultivo hidropónico"
        loading="eager"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="flex-1 flex items-center justify-center p-8 lg:p-16">
      <div class="w-full max-w-md">
        <div class="mb-10">
          <img src="/favicon.svg" alt="HydroGreen" class="w-10 h-10 mb-8" />
          <h1 class="font-display text-4xl font-bold text-ink mb-3 tracking-tight">
            Comienza tu <span class="text-green-700">viaje</span>
          </h1>
          <p class="text-ink-light text-lg">Únete ahora y comienza a explorar.</p>
        </div>

        <form action="#" method="post" class="flex flex-col gap-5">
          <Input type="text" placeholder="Nombre" name="name" />
          <Input type="email" placeholder="Correo electrónico" name="email" />
          <Input type="password" placeholder="Contraseña" name="password" />

          <button
            type="submit"
            class="mt-4 w-full py-4 bg-green-700 text-cream rounded-full text-base font-semibold hover:bg-green-800 hover:shadow-[var(--shadow-green-btn)] hover:scale-[1.02] active:scale-[0.97] transition-all duration-300"
          >
            Crear cuenta
          </button>
        </form>

        <p class="mt-8 text-center text-sm text-ink-light">
          ¿Ya tienes cuenta? <a
            href="/signin"
            class="text-green-700 font-semibold hover:text-green-800 transition-colors"
            >Inicia sesión</a
          >
        </p>
      </div>
    </div>
  </div>
</Layout>

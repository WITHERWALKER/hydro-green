---
import Input from "@/components/Input.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="Container">
    <div class="Form">
      <div class="Description">
        <h1>Comienza tu <span>viaje aqui!</span></h1>
        <p>Únete ahora y comienza a explorar.</p>
      </div>

      <form action="/api/auth/register" method="post">
        <Input type="text" placeholder="Nombre" name="name" />
        <Input type="email" placeholder="Correo electronico" name="email" />
        <Input type="password" placeholder="Contraseña" name="password" />

        <button type="submit">Sign Up</button>
      </form>
    </div>

    <img src="/img/Fresa8.webp" alt="" />
  </div>
</Layout>

<style lang="scss">
  body {
    background-color: var(--Bg-Color);
  }

  .Container {
    display: flex;
    justify-content: space-between;
    align-items: center;

    .Form {
      display: flex;
      justify-content: center;
      flex-direction: column;
      margin: 0 auto;
      padding: 3rem;
      height: 37.5rem;
      width: 28.125rem;
      background-color: #fff;
      border-radius: var(--Border);

      .Description {
        margin-bottom: 1.75rem;
        width: 100%;

        h1 {
          font-size: 2em;
          margin-bottom: 0.5rem;

          span {
            font-weight: 600;
            color: var(--Green-Color-700);
          }
        }

        p {
          color: var(--Grey-Color);
        }
      }

      button {
        margin: 4rem auto 0;
        display: flex;
        justify-content: center;
        padding: 0.7rem;
        width: 60%;
        background-color: var(--Green-Color-700);
        color: var(--Green-Color-50);
        border-radius: var(--Border);
        font-size: 1.1em;
        font-weight: 500;

        &:hover {
          background-color: var(--Green-Color-800);
          transition: 0.2s ease-out;
        }
      }
    }
  }

  img {
    width: 50%;
    height: 100vh;
    object-fit: cover;
  }

  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 1024px) {
    .Container {
      display: grid;
      justify-items: center;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      grid-template-areas: "Form";
      width: auto;

      .Form {
        padding: 1.5rem;
        width: 24rem;
        height: 33rem;
        border-radius: var(--Border);

        .Description {
          font-size: 0.9rem;
        }

        .Divisor {
          p {
            font-size: 0.8em;
          }
        }
      }

      img {
        display: none;
      }
    }
  }
</style>

---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <section class="text-gray-600 body-font overflow-hidden">
    <div class="container px-5 py-24 mx-auto">
      <div class="lg:w-4/5 mx-auto flex flex-wrap">
        <img
          alt="ecommerce"
          class="lg:w-1/2 w-full lg:h-auto h-64 object-cover aspect-square object-center rounded"
          src="/img/Fresa8.webp"
        />
        <div class="lg:w-1/2 w-full lg:p-10 lg:py-6 mt-6 lg:mt-0">
          <h2 class="text-sm title-font text-gray-500 tracking-widest mb-2">
            Fresas
          </h2>
          <h1 class="text-gray-900 text-6xl title-font font-medium mb-4">
            Paquete de Fresas
          </h1>

          <p class="leading-relaxed">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Culpa eum
            dolores nesciunt exercitationem accusantium quo modi? Ex culpa
            laudantium obcaecati!
          </p>
          <div
            class="flex mt-14 items-center pb-5 border-b-2 border-gray-100 mb-5"
          >
            <div class="flex ml-6 items-center">
              <span class="mr-3">Tamaño</span>
              <div class="relative">
                <select
                  class="rounded border appearance-none border-gray-300 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 text-base pl-3 pr-10"
                >
                  <option>SM</option>
                  <option>M</option>
                  <option>L</option>
                  <option>XL</option>
                </select>
                <span
                  class="absolute right-0 top-0 h-full w-10 text-center text-gray-600 pointer-events-none flex items-center justify-center"
                >
                  <svg
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </span>
              </div>
            </div>
          </div>
          <div class="flex">
            <span class="title-font font-medium text-2xl text-gray-900"
              >$80.00</span
            >
            <button
              class="flex ml-auto text-white bg-[#3c593c] border-0 py-2 px-6 focus:outline-none hover:bg-[#334833] rounded"
              >Comprar</button
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .container {
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  </style>
</Layout>

---
import Header from "@/components/DashboardComponents/Header.astro";
import Navbar from "@/components/DashboardComponents/Navbar.astro";

import "@fontsource-variable/inter";
import "@fontsource-variable/fraunces";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="HydroGreen - Dashboard de monitoreo hidropónico en tiempo real"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#255c2a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Dashboard | HydroGreen</title>
  </head>
  <body class="bg-cream text-ink antialiased">
    <div class="h-screen flex flex-col">
      <header>
        <Header />
      </header>
      <div class="flex flex-1 overflow-hidden">
        <nav>
          <Navbar />
        </nav>
        <main class="flex-1 overflow-auto">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

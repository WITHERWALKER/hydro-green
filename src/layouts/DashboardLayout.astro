---
import Header from "@/components/DashboardComponents/Header.astro";
import Navbar from "@/components/DashboardComponents/Navbar.astro";

import "@fontsource-variable/outfit";
import "@fontsource-variable/dm-sans";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>HydroGreen</title>
  </head>
  <body>
    <div class="Container">
      <header>
        <Header />
      </header>
      <section>
        <slot />
      </section>
      <nav>
        <Navbar />
      </nav>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --Green-Color-50: #f5f8f5;
    --Green-Color-100: #e8f0e8;
    --Green-Color-200: #d1e1d1;
    --Green-Color-300: #adc8ad;
    --Green-Color-400: #80a880;
    --Green-Color-500: #557c55;
    --Green-Color-600: #4a6f4a;
    --Green-Color-700: #3c593c;
    --Green-Color-800: #334833;
    --Green-Color-900: #2b3c2c;
    --Green-Color-950: #141f15;

    --Grey-Color: #8b949e;
    --Black-Color: #212121;
    --Bg-Color: #eeeeee;
    --White-Color: #f0f0f0;
    --Border: 0.5rem;
  }

  html {
    font-family: "Outfit Variable", sans-serif;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
</style>

<style>
  .Container {
    background-color: var(--Bg-Color);
    height: 100vh;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    grid-template-areas:
      "Header Header Header"
      "Nav Main Main"
      "Nav Main Main";
  }

  header {
    grid-area: Header;
  }

  section {
    grid-area: Main;
    height: calc(100vh - 4rem);
    width: calc(100vw - 5rem);
  }

  nav {
    grid-area: Nav;
  }
</style>

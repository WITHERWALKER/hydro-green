---
import Logo from "./Logo.astro";
---

<header class="w-full my-0 mx-auto p-5">
  <div
    class="container mx-auto flex flex-wrap flex-col md:flex-row items-center"
  >
    <Logo />
    <nav
      class="md:mr-auto md:ml-4 md:py-1 md:pl-4 md:border-l md:border-gray-400 flex flex-wrap items-center text-base justify-center"
    >
      <a class="mr-5 hover:text-gray-900">First Link</a>
      <a class="mr-5 hover:text-gray-900">Second Link</a>
      <a href="/signin" class="mr-5 hover:text-gray-900">Sign In</a>
      <a href="/signup" class="mr-5 hover:text-gray-900">Sign Up</a>
    </nav>
    <a
      href="/dashboard"
      class="inline-flex items-center bg-gray-100 border-0 py-1 px-3 focus:outline-none hover:bg-gray-200 rounded text-base mt-4 md:mt-0"
      >Get Start
    </a>
  </div>
</header>

<style lang="scss">
  header {
    backdrop-filter: blur(1rem);
    position: sticky;
    top: 0;
    animation: header linear both;
    animation-timeline: scroll();
    animation-range: 0 20rem;
  }

  @keyframes header {
    to {
      background-color: rgba(0, 0, 0, 0.1);
      top: 0.5rem;
      width: 90%;
      margin: 0 auto;
      padding: 0.5rem;
      border-radius: 1.5rem;
    }
  }
</style>

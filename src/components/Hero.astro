---
import Divisor from "./Divisor.astro";
---

<section>
  <div class="Info">
    <h1>
      Cultiva Fresas Excepcionales<span> &bull;HydroGreen&bull;</span>
    </h1>
    <p>
      Descubre el poder de HydroGreen para cultivar fresas de manera sostenible
      y eficiente. Nuestro sistema te guiará en el viaje hacia una producción
      agrícola más verde.
    </p>
    <a href="/signup">&bull; Empieza Aqui &bull;</a>
  </div>
  <img src="/img/Fresa6.png" alt="" />
</section>
<Divisor />

<style lang="scss">
  section {
    position: relative;
    display: flex;
    height: 80vh;
    border-radius: var(--Border);
    background: linear-gradient(220.55deg, #fff6eb 0%, #dfd1c5 100%);
    border: 3px solid var(--Green-Color-700);
  }

  .Info {
    display: flex;
    justify-content: center;
    flex-direction: column;
    padding-left: 5rem;
    gap: 2rem;
    width: 70%;

    h1 {
      font-size: 7em;
      font-weight: 400;
      line-height: 0.9;

      span {
        font-weight: 600;
        color: var(--Green-Color-700);
        font-family: "Arya", sans-serif;
      }
    }

    p {
      width: 70%;
    }

    a {
      max-width: 55%;
      text-align: center;
      font-size: 1.2em;
      font-weight: 500;
      padding: 0.5rem 0.9rem;
      border-radius: var(--Border);
      color: var(--Green-Color-50);
      background-color: var(--Green-Color-700);

      &:hover {
        background-color: var(--Green-Color-800);
        transition: 0.2s ease-out;
      }
    }
  }

  img {
    display: flex;
    width: 100%;
    object-fit: contain;
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 1645px) {
    img {
      width: 40%;
    }
  }

  @media (width <= 1450px) {
    img {
      width: 30%;
    }
  }

  @media (width <= 1240px) {
    .Info {
      width: 100%;
      padding-left: 3rem;

      p {
        width: 50%;
      }
    }

    img {
      width: 40%;
      position: absolute;
      bottom: 0;
      right: 0;
    }
  }

  @media (width <= 1130px) {
    .Info {
      align-items: center;
      padding: 5rem 2rem;

      h1 {
        text-align: center;
      }

      p {
        width: 70%;
        text-align: center;
      }
    }

    img {
      margin: 0;
      display: none;
    }
  }

  @media (width <= 810px) {
    .Info {
      h1 {
        font-size: 5em;
      }
    }
  }

  @media (width <= 640px) {
    .Info {
      h1 {
        font-size: 4em;
      }
    }
  }

  @media (width <= 480px) {
    .Info {
      padding: 1rem;

      h1 {
        font-size: 3em;
      }

      p {
        width: 100%;
        font-size: 0.8em;
      }

      a {
        font-size: 1em;
        padding: 0.5rem;
        width: 100%;
      }
    }
  }
</style>

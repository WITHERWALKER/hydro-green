---
import Divisor from "./Divisor.astro";
---

<section>
  <div class="Info">
    <h1>
      Cultiva Fresas Excepcionales<span> &bull;HydroGreen&bull;</span>
    </h1>
    <p>
      Descubre el poder de HydroGreen para cultivar fresas de manera sostenible
      y eficiente. Nuestro sistema te guiará en el viaje hacia una producción
      agrícola más verde.
    </p>
    <a href="/signup">&bull; Empieza Aqui &bull;</a>
  </div>
  <img src="/img/Fresas.png" alt="" />
</section>
<Divisor />

<style lang="scss">
  section {
    display: flex;
    justify-content: center;
    height: 80vh;
    border-radius: var(--Border);
    background: var(--Bg-Gradient);
    border: 3px solid var(--Green-Color-700);
  }

  .Info {
    display: flex;
    justify-content: center;
    flex-direction: column;
    padding-left: 5rem;
    gap: 2rem;

    h1 {
      font-size: clamp(2.3rem, 0.7925rem + 6.0377vw, 8rem);
      font-weight: 400;
      line-height: 0.9;

      span {
        font-weight: 600;
        color: var(--Green-Color-700);
        font-family: "Arya", sans-serif;
      }
    }

    p {
      max-width: 75%;
      font-size: clamp(0.65rem, 0.55rem + 0.5vw, 1rem);
    }

    a {
      max-width: 55%;
      text-align: center;
      font-size: 1.2em;
      font-weight: 500;
      padding: 0.5rem 0.9rem;
      border-radius: var(--Border);
      color: var(--Green-Color-50);
      background-color: var(--Green-Color-700);

      &:hover {
        background-color: var(--Green-Color-800);
        transition: 0.2s ease-out;
      }
    }
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 1670px) {
    img {
      width: 40%;
    }
  }

  // Media Queries ------------------------------------------------ */

  @media (width <= 1024px) {
    section {
      flex-direction: column;
      align-items: center;
    }

    .Info {
      text-align: center;
      align-items: center;
      padding: 3rem 1rem 0;
    }

    img {
      // width: 40%;
    }
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 425px) {
    img {
      width: 80%;
    }
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 425px) {
    .Info {
      padding: 2rem 1rem;

      a {
        font-size: 0.8rem;
        padding: 0.5rem;
        width: 100%;
      }
    }

    img {
      width: 80%;
    }
  }
</style>

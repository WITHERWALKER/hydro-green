---
import Logout from "@/components/Icons/Logout.astro";
---

<div class="Container">
  <img class="" src="" alt="" />

  <div class="User">
    <h1>Bienvenido</h1>
    <p>User</p>
  </div>

  <button>
    <Logout />
  </button>
</div>

<style lang="scss">
  .Container {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1rem;
    border-left: 2px solid var(--Green-Color-400);

    img {
      border-radius: 50%;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .User {
    h1 {
      font-size: 1.1em;
      font-weight: 600;
      color: var(--Black-Color);
    }

    p {
      font-size: 1em;
      color: var(--Black-Color);
    }
  }
</style>

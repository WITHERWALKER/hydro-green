---
import Logout from "@/components/Icons/Logout.astro";
---

<div class="Container">
  <img class="" src="" alt="" />

  <div class="User">
    <h1>Bienvenido</h1>
    <p>
      <h1>User</h1>
    </p>
  </div>

  <button>
    <Logout />
  </button>
</div>

<style lang="scss">
  .Container {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-right: 1.5rem;

    img {
      border-radius: 50%;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .User {
    h1 {
      font-size: 0.9em;
      font-weight: 600;
      color: var(--White-Color);
    }

    p {
      font-size: 1em;
      color: var(--White-Color);
    }
  }
</style>

---
import Logout from "@/components/Icons/Logout.astro";
---

<div class="Container">
  <div class="User">
    <h1>Bienvenido</h1>
    <p>User</p>
  </div>
  <img class="" src="" alt="" />

  <button>
    <Logout />
  </button>
</div>

<style lang="scss">
  .Container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 2rem;

    img {
      border-radius: 50%;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .User {
    line-height: normal;
    h1 {
      font-size: 1.1em;
      font-weight: 600;
      color: var(--Green-Color-800);
    }

    p {
      font-size: 1.2em;
      color: var(--Green-Color-800);
    }
  }

  button {
    color: yellow;
  }
</style>

---
import Button from "@/components/DashboardComponents/ButtonCircle.astro";
const { title } = Astro.props;
const { subtitle } = Astro.props;
const { info } = Astro.props;
---

<div>
  <header>
    <h4>{title}</h4>
    <Button />
  </header>
  <span>4</span>
  <footer>
    <span>{subtitle}</span>
    <span>{info}</span>
  </footer>
</div>

<style lang="scss">
  div {
    padding: 1.5rem;
    background-color: #fff;
    border-radius: var(--Border);

    header {
      display: flex;
      justify-content: space-between;

      h4 {
        font-size: 1.1em;
        margin-bottom: 0.5rem;
      }
    }

    span {
      font-size: 3em;
    }

    footer {
      display: flex;
      justify-content: space-between;

      span {
        font-size: 0.8em;
      }
    }
  }
</style>

---
import ArrowLink from "../Icons/ArrowLink.astro";
---

<a href="#">
  <ArrowLink />
</a>

<style>
  a {
    padding: 0.3125rem;
    border: 2px dashed var(--Border-Color);
    border-radius: 50%;
  }

  a:hover {
    background-color: var(--Bg-Color);
    transition: 0.3s ease-out;
    border: 2px dashed var(--White-Color);
    color: var(--White-Color);
  }
</style>

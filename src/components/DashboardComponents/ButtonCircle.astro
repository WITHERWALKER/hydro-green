---
import ArrowLink from "../Icons/ArrowLink.astro";
---

<a href="#">
  <ArrowLink />
</a>

<style>
  a {
    border: 2px dashed var(--Black-Color);
    color: var(--Black-Color);
    padding: 0.3125rem;
    border-radius: 50%;
  }

  a:hover {
    border: 2px dashed var(--Green-Color-400);
    color: var(--Green-Color-400);
    transition: 0.2s ease-out;
  }
</style>

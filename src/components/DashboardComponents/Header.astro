---
import Avatar from "@/components/DashboardComponents/Avatar.astro";
import Button from "@/components/Button.astro";
import Logo from "@/components/Logo.astro";
---

<header>
  <Logo />
  <div class="Session">
    <div class="Info">
      <Button title="Support" link="#" />
      <Button title="Upgrate" link="#" />
    </div>

    <Avatar />
  </div>
</header>

<style lang="scss">
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
    border-bottom: 2px solid var(--Green-Color-300);

    .Session {
      display: flex;
      gap: 1rem;

      .Info {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-right: 1rem;
        border-right: 2px solid var(--Green-Color-300);
      }
    }
  }
</style>

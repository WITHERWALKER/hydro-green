---
import Logo from "@/components/ui/Logo.astro";
import { ArrowLeft } from "@lucide/astro";
---

<header
  class="sticky top-0 z-20 flex h-17 shrink-0 items-center justify-between border-b border-[#E8E2D6]/60 bg-[#F5F0E8]/80 px-4 backdrop-blur-md sm:px-6 lg:px-8"
>
  <Logo />
  <a
    href="/"
    class="inline-flex items-center gap-2 rounded-xl border border-transparent px-3.5 py-2 text-[13px] font-medium text-[#6B6B6B] transition-colors duration-300 ease-out hover:border-[#E8E2D6] hover:bg-white hover:text-[#111413] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700/20"
  >
    <ArrowLeft class="h-4 w-4" />
    Volver al sitio
  </a>
</header>

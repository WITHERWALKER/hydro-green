---
import Avatar from "@/components/DashboardComponents/Avatar.astro";
import Notification from "../Icons/Notification.astro";
---

<header>
  <div class="Logo">
    <img src="/favicon.svg" alt="" />
  </div>
  <div class="Session">
    <button>
      <Notification />
    </button>
    <Avatar />
  </div>
</header>

<style lang="scss">
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
    border-bottom: 2px solid var(--Green-Color-300);

    .Logo {
      display: flex;
      justify-content: center;
      width: 5rem;
      height: 100%;
      border-right: 2px solid var(--Green-Color-300);

      img {
        width: 2rem;
      }
    }

    .Session {
      display: flex;
      align-items: center;
      gap: 2rem;

      button {
        padding: 0.5rem;
      }
    }
  }
</style>

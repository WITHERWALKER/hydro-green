---
import Button from "../Button.astro";
import Dashboard from "../Icons/Dashboard.astro";
import Settings from "../Icons/Settings.astro";
---

<nav>
  <ul>
    <li>
      <a href="/dashboard">
        <Dashboard />
      </a>
    </li>
    <li>
      <a href="">
        <Settings />
      </a>
    </li>
  </ul>
</nav>

<style lang="scss">
  nav {
    padding: 1rem 0;
    width: 5rem;
    height: calc(100vh - 4rem);
    border-right: 2px solid var(--Green-Color-300);
  }

  ul {
    display: flex;
    flex-flow: column wrap;
    align-content: center;
    gap: 1rem;

    li {
      padding: 0.6rem;
      border-radius: var(--Border);
      background-color: var(--Green-Color-500);
      color: var(--Green-Color-50);

      &:hover {
        background-color: var(--Green-Color-400);
        transition: all 0.2s ease-out;
      }
    }
  }
</style>

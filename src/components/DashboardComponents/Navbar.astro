---
import Dashboard from "../Icons/Dashboard.astro";
import Settings from "../Icons/Settings.astro";
---

<nav>
  <ul>
    <li>
      <a href="/dashboard">
        <span class="Tooltip">Panel</span>
        <Dashboard />
      </a>
    </li>
    <li>
      <a href="">
        <span class="Tooltip">Ajustes</span>
        <Settings />
      </a>
    </li>
  </ul>
</nav>

<style lang="scss">
  nav {
    padding: 1rem 0;
    width: 5rem;
    height: calc(100vh - 4rem);
    border-right: 2px solid var(--Green-Color-300);
  }

  ul {
    display: flex;
    flex-flow: column wrap;
    align-content: center;
    gap: 1rem;

    li {
      border-radius: var(--Border);
      background-color: var(--Green-Color-500);
      color: var(--Green-Color-50);

      &:hover {
        background-color: var(--Green-Color-400);
        transition: 0.3s ease-out;
      }
    }
  }

  a {
    position: relative;
    display: block;
    padding: 0.6rem;
  }

  .Tooltip {
    position: absolute;
    top: 0%;
    left: 170%;
    padding: 0.6em 0.7rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: 0.3s ease-out;
    border-radius: var(--Border);
    background: var(--Green-Color-400);
  }

  a:hover .Tooltip {
    opacity: 0.5;
    visibility: visible;
    pointer-events: auto;
  }
</style>

<style lang="scss">
  article {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(5, 1fr);
    grid-template-areas:
      "S1 S4 S5 S7"
      "S1 S4 S5 S7"
      "S2 S4 S6 S7"
      "S2 S3 S6 S8"
      "S2 S3 S6 S8";
    gap: 1rem;
    height: 90vh;
    margin-bottom: 10rem;
  }

  section {
    padding: 2rem;
    border-radius: var(--Border);
    // background: var(--Bg-Gradient);
    border: 3px solid var(--Green-Color-700);

    h1 {
      font-size: 2.5em;
      font-weight: 500;
      line-height: 1;
    }
  }

  .S1 {
    grid-area: S1;
  }

  .S2 {
    grid-area: S2;
  }

  .S3 {
    grid-area: S3;
  }

  .S4 {
    grid-area: S4;
  }

  .S5 {
    grid-area: S5;
  }

  .S6 {
    grid-area: S6;
  }

  .S7 {
    grid-area: S8;
  }

  .S8 {
    grid-area: S7;
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 1200px) {
    article {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(8, 1fr);
      grid-template-areas:
        "S1 S2"
        "S1 S2"
        "S3 S4"
        "S3 S4"
        "S5 S6"
        "S5 S6"
        "S7 S8"
        "S7 S8";
      height: auto;
    }

    section {
      height: 15rem;

      h1 {
        font-size: 2em;
      }
    }
  }

  // Media Queries ------------------------------------------------ */
  @media (width <= 768px) {
    article {
      grid-template-columns: repeat(1, 1fr);
      grid-template-rows: repeat(8, 1fr);
      grid-template-areas:
        "S1"
        "S2"
        "S3"
        "S4"
        "S5"
        "S6"
        "S7"
        "S8";
    }

    section {
      p {
        padding: 1em 0;
      }
    }
  }
</style>

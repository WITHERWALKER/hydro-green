---
import { Plus } from "@lucide/astro";

interface Props {
  number: number | string;
  title: string;
  open?: boolean;
}

const { number, title, open = false } = Astro.props;
---

<details class="group border-b border-neutral-200 py-5 sm:py-6" open={open}>
  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 sm:gap-8">
    <div class="flex gap-3 sm:gap-4 min-w-0">
      <span class="text-sm sm:text-lg font-medium text-neutral-900 shrink-0 leading-6 sm:leading-8">
        {number}.
      </span>

      <h3
        class="text-lg sm:text-xl lg:text-2xl font-medium text-neutral-900 leading-tight sm:leading-8 text-pretty"
      >
        {title}
      </h3>
    </div>

    <div
      class="flex size-8 sm:size-8 shrink-0 items-center justify-center rounded-full border border-neutral-300 transition-transform duration-300 group-open:rotate-45"
    >
      <Plus class="size-4 sm:size-4.5" />
    </div>
  </summary>

  <div class="grid transition-all duration-300 grid-rows-[0fr] group-open:grid-rows-[1fr]">
    <div class="overflow-hidden">
      <p
        class="mt-4 sm:mt-6 max-w-xl text-[15px] sm:text-base pl-8 sm:pl-10 text-neutral-500 leading-relaxed text-pretty"
      >
        <slot />
      </p>
    </div>
  </div>
</details>

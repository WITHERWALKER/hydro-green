---
import { Plus } from "@lucide/astro";

interface Props {
  number: number | string;
  title: string;
  open?: boolean;
}

const { number, title, open = false } = Astro.props;
---

<details class="group border-b border-neutral-200 py-6" open={open}>
  <summary class="flex cursor-pointer list-none items-start justify-between gap-8">
    <div class="flex gap-4">
      <span class="text-lg font-medium text-neutral-900">
        {number}.
      </span>

      <h3 class="text-2xl font-medium text-neutral-900">
        {title}
      </h3>
    </div>

    <div
      class="flex size-8 shrink-0 items-center justify-center rounded-full border border-neutral-300 transition-transform duration-300 group-open:rotate-45"
    >
      <Plus />
    </div>
  </summary>

  <div class="grid transition-all duration-300 grid-rows-[0fr] group-open:grid-rows-[1fr]">
    <div class="overflow-hidden">
      <p class="mt-6 max-w-xl text-base pl-10 text-neutral-500">
        <slot />
      </p>
    </div>
  </div>
</details>

---
interface Props {
  variant?: "default" | "success" | "warning" | "info";
  text: string;
  class?: string;
}

const { variant = "default", text, class: className = "" } = Astro.props;

const variants = {
  default: "bg-green-100/80 text-green-800",
  success: "bg-green-100 text-green-700",
  warning: "bg-amber-100 text-amber-700",
  info: "bg-blue-100 text-blue-700",
};
---

<span
  class={`inline-flex items-center gap-2 px-4 py-1.5 rounded-full ${variants[variant]} ${className}`}
>
  <span class="text-xs font-medium uppercase tracking-wider">{text}</span>
</span>

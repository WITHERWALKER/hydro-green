---
const { title, link } = Astro.props;
---

<a href={link}>
  {title}
</a>

<style>
  a {
    border: 2px solid var(--Secondary-Color);
    border-radius: var(--Border);
    color: var(--Black-Color);
    padding: 0.3rem 0.75rem;
    font-size: 1.1em;
  }

  a:hover {
    border: 2px solid var(--Hover-Secondary-Color);
    cursor: pointer;
    transition: 0.4s ease-out;
  }
</style>

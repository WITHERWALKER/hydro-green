---
const { title, link } = Astro.props;
---

<a href={link}>
  {title}
</a>

<style>
  a {
    background-color: var(--Bg-Color);
    border: 2px solid #3e3e3e;
    border-radius: var(--Border-Radius);
    color: var(--White-Color);
    padding: 8px 15px;
    font-size: 1em;
  }

  a:hover {
    border: 2px solid var(--White-Color);
    cursor: pointer;
    transition: 0.4s ease;
  }
</style>

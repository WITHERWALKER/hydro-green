---
const { type, placeholder } = Astro.props;
---

<input required="" type={type} autocomplete="off" placeholder={placeholder} />

<style>
  input {
    width: 100%;
    height: 3.25rem;
    border: 1px solid #b6b6b6;
    border-radius: 0.5rem;
    padding: 0.75rem;
  }

  input:focus {
    outline: none;
    border: 2px solid var(--Green-Color-600);
  }
</style>

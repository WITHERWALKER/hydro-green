---
const { type, placeholder, name } = Astro.props;
---

<input
  required=""
  type={type}
  autocomplete="off"
  placeholder={placeholder}
  name={name}
/>

<style>
  input {
    width: 100%;
    height: 3.25rem;
    border: 2px solid var(--Green-Color-700);
    background-color: inherit;
    border-radius: 0.5rem;
    padding: 0.75rem;
  }

  input::placeholder {
    color: var(--Black-Color);
    font-weight: 500;
    opacity: 0.5;
  }

  input:focus {
    outline: none;
    border: 3px solid var(--Green-Color-800);
  }
</style>

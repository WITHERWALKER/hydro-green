---
interface Props {
  type?: string;
  placeholder?: string;
  name?: string;
  id?: string;
  required?: boolean;
  autocomplete?: string;
  value?: string;
}

const {
  type = "text",
  placeholder,
  name,
  id,
  required = true,
  autocomplete = "off",
  value,
} = Astro.props;
---

<input
  id={id}
  type={type}
  name={name}
  placeholder={placeholder}
  required={required}
  autocomplete={autocomplete}
  value={value}
  class="w-full h-13 px-6 bg-surface border border-sand rounded-full text-[15px] text-ink placeholder:text-ink-muted placeholder:font-medium focus:outline-none focus:border-green-300 focus:ring-4 focus:ring-green-500/10 hover:border-sand transition-all duration-200"
/>

---
import SectionLabel from "@/components/ui/SectionLabel.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import Container from "@/components/ui/Container.astro";

import { accordion } from "@/data/constants";

import StrawberryVertical from "@/assets/strawberry.webp";
---

<section id="solutions" class="py-16 sm:py-20 lg:py-28 xl:py-32">
  <Container>
    <header class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
      <p
        class="flex items-end max-w-lg text-neutral-600 text-pretty leading-relaxed text-[15px] sm:text-base order-2 lg:order-1 lg:pb-2"
      >
        Combinamos ingeniería agrícola y tecnología hidropónica para optimizar el uso del agua,
        mejorar la calidad del cultivo y ofrecer un control preciso en cada etapa de producción.
      </p>

      <div class="order-1 lg:order-2">
        <SectionLabel title="Tecnología y Soluciones" />

        <h2
          class="mt-4 sm:mt-6 max-w-2xl font-semibold tracking-tight text-balance leading-[0.95] sm:leading-none
                 text-[clamp(1.75rem,6vw,2.5rem)] sm:text-4xl lg:text-5xl lg:leading-[1.05]"
        >
          Innovación aplicada al cultivo hidropónico de fresas.
        </h2>
      </div>
    </header>

    <div
      class="mt-10 sm:mt-14 lg:mt-20 grid grid-cols-1 gap-8 sm:gap-10 lg:gap-12 xl:gap-16 lg:grid-cols-2 lg:items-center"
    >
      <div class="order-2 lg:order-1">
        <img
          src={StrawberryVertical.src}
          alt="Sistema hidropónico para cultivo de fresas"
          class="aspect-4/3 sm:aspect-3/4 lg:aspect-4/5 w-full object-cover rounded-xl"
          width="600"
          height="750"
          loading="lazy"
        />
      </div>

      <div class="order-1 lg:order-2">
        {
          accordion.map((item, index) => (
            <AccordionItem number={item.number} title={item.title} open={index === 0}>
              {item.description}
            </AccordionItem>
          ))
        }
      </div>
    </div>
  </Container>
</section>

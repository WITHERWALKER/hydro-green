---
import { Droplets, Thermometer, Waves, Gauge, Zap, Sun, CircleDashed } from "@lucide/astro";
import Container from "@/components/ui/Container.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { sensors } from "@/data/sensors";

const iconMap: Record<string, any> = {
  Droplets,
  Thermometer,
  Waves,
  Gauge,
  Zap,
  Sun,
  CircleDashed,
};
---

<section class="py-32 px-6 bg-green-950">
  <Container>
    <SectionTitle
      badge="Monitoreo en tiempo real"
      title="Sensores inteligentes"
      description="Datos precisos de cada variable para optimizar tu cultivo al máximo."
      class="text-cream [&_span]:bg-green-900/50 [&_span]:text-green-300 [&_p]:text-green-300/80"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        sensors.map((sensor) => {
          const Icon = iconMap[sensor.icon];
          return (
            <article class="group relative p-6 bg-green-900/50 border border-green-800/50 rounded-2xl backdrop-blur-sm transition-all duration-300 ease-out hover:border-green-600/50 hover:bg-green-900/70">
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-green-800/50 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:bg-green-700/50 text-green-300">
                  <Icon class="w-6 h-6" />
                </div>
                <span class="text-xs font-medium text-green-400 bg-green-900/50 px-2.5 py-1 rounded-full">
                  {sensor.status}
                </span>
              </div>
              <h3 class="font-display text-2xl font-bold text-cream mb-1">{sensor.title}</h3>
              <p class="text-sm text-green-300/60">{sensor.description}</p>
              <div class="mt-4 flex items-end gap-2">
                <span class="text-3xl font-display font-bold text-green-300">{sensor.value}</span>
                <span class="text-sm text-green-400/60 mb-1">{sensor.unit}</span>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>

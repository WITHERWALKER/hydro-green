---
import StrawberryVertical from "@/assets/strawberry-about.webp";
import SectionLabel from "../ui/SectionLabel.astro";
import { ArrowUpRight } from "@lucide/astro";
---

<section id="cta" class="pt-32">
  <div
    class="flex min-h-[80vh] items-center bg-cover bg-center p-6 md:p-10 lg:p-16"
    style={`background-image: url(${StrawberryVertical.src})`}
  >
    <article class="max-w-2xl rounded-xl bg-white p-8 shadow-sm md:p-10 lg:p-12">
      <SectionLabel title="¿Listo para comenzar?" />

      <h2 class="mt-6 text-4xl font-semibold">
        Transforma tu producción con hidroponía de precisión
      </h2>

      <p class="mt-6 max-w-xl text-balance text-neutral-600">
        Te ayudamos a diseñar e implementar sistemas hidropónicos para el cultivo de fresas,
        optimizando recursos, mejorando la calidad del fruto y acompañándote en cada etapa del
        proyecto.
      </p>

      <a
        href="/contacto"
        class="mt-10 inline-flex items-center gap-2 rounded-xl bg-lime-500 px-6 py-3 font-medium text-neutral-900 transition-colors hover:bg-lime-600"
      >
        Solicitar asesoría
        <ArrowUpRight class="size-5" />
      </a>
    </article>
  </div>
</section>

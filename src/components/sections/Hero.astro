---
import heroBackground from "@/assets/hero-bg.jpg";
import { ArrowUpRight } from "@lucide/astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Header from "@/components/sections/Header.astro";
---

<section
  class="relative h-dvh flex flex-col justify-between overflow-hidden bg-black-950"
  style={`background-image: url(${heroBackground.src}); background-size: cover; background-position: center; background-repeat: no-repeat`}
>
  <div class="absolute inset-0 bg-linear-to-b from-black/40 via-black/20 to-black/50"></div>

  <div class="relative z-10">
    <Header />

    <div class="px-6 pt-16 sm:pt-24">
      <Container>
        <h1 class="text-8xl font-display text-cream tracking-tight leading-20 max-w-2xl">
          La nueva forma de cultivar fresas con precisión.
        </h1>
      </Container>
    </div>
  </div>

  <div class="relative z-10 px-6 pb-12 sm:pb-16">
    <Container>
      <div class="max-w-2xl ml-auto text-right">
        <p class="text-lg sm:text-xl text-cream/90 leading-relaxed text-balance">
          Diseñamos e implementamos sistemas hidropónicos que optimizan el uso de agua, mejoran la
          calidad del fruto y aumentan la productividad de cada cultivo.
        </p>
      </div>
    </Container>
  </div>
</section>
